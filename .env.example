# Copy to .env (git ignores it) and replace every placeholder.
# These values are for the local development stack only.

# Owner of the development database.
POSTGRES_PASSWORD=change-me-owner
# The API's read-only role.
API_READER_PASSWORD=change-me-reader

# Optional.
# FIXTURE_PROFILE=tiny          # tiny, ci or benchmark
# FIXTURE_SEED=1
# API_PUBLISH=[::1]:8080        # host address and port the API is published on (loopback only)
