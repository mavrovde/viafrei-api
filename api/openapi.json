  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "The process runs and answers. Never touches storage (FR-SVC-004).",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Liveness",
        "tags": [
          "service"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Storage answers within the readiness timeout and publishes a compatible read contract (FR-SVC-004).",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Not ready: a check failed."
          }
        },
        "summary": "Readiness",
        "tags": [
          "service"
        ]
      }
    },
    "/v1/meta": {
      "get": {
        "description": "The API version, the build revision and the read-contract version.",
        "operationId": "getMeta",
        "responses": {
          "200": {
